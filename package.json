{
  "name": "@1agents/transcribe",
  "version": "0.2.0",
  "description": "Ultra-fast on-device ASR engine & CLI with ModelScope auto-acceleration, Metal/GPU inference, and subtitle generator.",
  "keywords": [
    "asr",
    "speech-to-text",
    "transcribe",
    "sensevoice",
    "whisper",
    "subtitles",
    "srt",
    "modelscope",
    "1agents",
    "cli"
  ],
  "license": "MIT",
  "author": "1agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottzx/transcribe.git"
  },
  "bugs": {
    "url": "https://github.com/scottzx/transcribe/issues"
  },
  "homepage": "https://github.com/scottzx/transcribe#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "transcribe": "bin/transcribe.js",
    "1transcribe": "bin/transcribe.js"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@1agents/dreammate-node": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
